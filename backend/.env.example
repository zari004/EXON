PORT=3000
NODE_ENV=production

# Admin panel paroli — docs/admin.html shu bilan kiradi
ADMIN_PASSWORD=

# Telegram Bot — @BotFather'dan oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Frontend URL (CORS) — sizning maxsus domeningiz
FRONTEND_URL=https://exon-marketing.uz

# Gmail SMTP — Google akkauntida 2 bosqichli himoyani yoqing va
# https://myaccount.google.com/apppasswords orqali 16 belgili App Password yarating.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=

# Database — Supabase Postgres ulanish satri
# Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PAROL]@db.[PROJECT-REF].supabase.co:5432/postgres
